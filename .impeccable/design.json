  "narrative": {
    "northStar": "The Paper-First Workbench",
    "overview": "外贸单证系统是一张围绕纸张组织的工作台，而不是装饰性 dashboard。冷灰工作区承载高密度表单，白色面板和 A4 纸张保持清晰边界，品牌蓝只负责当前选择、关键动作和焦点。用户应先看清单证状态与下一步，再注意到视觉风格。\n\n系统以结构化录入和即时纸张反馈为核心。编辑器没有自由拖拽画布，也不把主数据、金额或版式状态藏在多层页面之后；表单、预览和导出共享同一份事实。视觉表达服务于长时间录入、复核和导出。",
    "keyCharacteristics": [
      "纸张是视觉中心，蓝色只标记行动与当前状态。",
      "细边框、紧凑节奏和明确对齐优先于装饰性卡片。",
      "桌面三栏协作，手机保留编辑、预览和固定下载闭环。",
      "多语言、多页和空状态沿用同一套单证语法。"
    ],
    "rules": [
      { "name": "The Single Action Voice Rule", "body": "同一视图只保留一个品牌蓝主行动；辅助操作使用白底、灰字或文字按钮，避免多个主按钮争夺任务优先级。", "section": "colors" },
      { "name": "The Real Copy Rule", "body": "所有字号与换行以真实单证编号、客户名、商品说明和多语言标签验证；不允许为了维持单行而截断关键业务信息。", "section": "typography" },
      { "name": "The Flat Work Surface Rule", "body": "工作面板保持平面；只有纸张、浮层或固定主行动可以浮起。", "section": "elevation" }
    ],
    "dos": [
      "Do 让下载 PDF 成为编辑器唯一主行动，并显示真实生成进度或错误。",
      "Do 使用 tabular-nums 对齐金额、件数、重量和编号。",
      "Do 在手机保留编辑、预览和固定下载的完整闭环。",
      "Do 明确标注“仅保存在当前浏览器”，将印章描述为单证图像。",
      "Do 用真实多语言、长商品说明和两页单证检查布局。"
    ],
    "donts": [
      "Don't 把工作台改成营销首页、自由拖拽画布或装饰性指标 dashboard。",
      "Don't 用多个品牌蓝主按钮竞争同一视图的注意力。",
      "Don't 用灰色文字放在彩色表面上充当次要文本，或牺牲对比度换取轻盈感。",
      "Don't 伪造云端保存、PDF 成功、法律电子签名或真实企业数据。",
      "Don't 在装箱单默认视图中显示单价和金额。"
    ]
  }
